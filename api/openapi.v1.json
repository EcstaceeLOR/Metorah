{
  "openapi": "3.1.0",
  "info": {
    "title": "Metorah Public API",
    "version": "1.0.0",
    "description": "Tenant identity and roles are derived only from a cryptographically verified bearer token. Clients cannot supply tenant scope."
  },
  "servers": [
    {
      "url": "https://api.metorah.example/api/v1",
      "description": "Deployment placeholder"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/readyz": {
      "get": {
        "operationId": "readiness",
        "summary": "Public process readiness",
        "security": [],
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/migrations": {
      "post": {
        "operationId": "createMigration",
        "summary": "Create migration in authenticated tenant",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Migration"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMigrationRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ]
      }
    },
    "/migrations/{migrationId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/MigrationId"
        }
      ],
      "get": {
        "operationId": "getMigration",
        "summary": "Read migration metadata",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Migration"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          }
        },
        "parameters": []
      }
    },
    "/migrations/{migrationId}/status": {
      "parameters": [
        {
          "$ref": "#/components/parameters/MigrationId"
        }
      ],
      "get": {
        "operationId": "getMigrationStatus",
        "summary": "Read lifecycle and accounting status",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MigrationStatus"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          }
        },
        "parameters": []
      }
    },
    "/migrations/{migrationId}/verification-runs": {
      "parameters": [
        {
          "$ref": "#/components/parameters/MigrationId"
        }
      ],
      "post": {
        "operationId": "startVerification",
        "summary": "Start durable verification job",
        "responses": {
          "202": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerificationRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ]
      }
    },
    "/migrations/{migrationId}/approvals": {
      "parameters": [
        {
          "$ref": "#/components/parameters/MigrationId"
        }
      ],
      "post": {
        "operationId": "submitApproval",
        "summary": "Record signed approval for exact subject digest",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Approval"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprovalRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ]
      }
    },
    "/migrations/{migrationId}/activation": {
      "parameters": [
        {
          "$ref": "#/components/parameters/MigrationId"
        }
      ],
      "post": {
        "operationId": "requestActivation",
        "summary": "Request activation after lifecycle and approval checks",
        "responses": {
          "202": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActivationRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ]
      }
    },
    "/migrations/{migrationId}/cancellation": {
      "parameters": [
        {
          "$ref": "#/components/parameters/MigrationId"
        }
      ],
      "post": {
        "operationId": "cancelMigration",
        "summary": "Request cancellation when lifecycle permits",
        "responses": {
          "202": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancellationRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ]
      }
    },
    "/migrations/{migrationId}/disputes": {
      "parameters": [
        {
          "$ref": "#/components/parameters/MigrationId"
        }
      ],
      "post": {
        "operationId": "createDispute",
        "summary": "Open a dispute",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Dispute"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DisputeRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ]
      }
    },
    "/migrations/{migrationId}/proofs/{proofId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/MigrationId"
        },
        {
          "$ref": "#/components/parameters/ProofId"
        }
      ],
      "get": {
        "operationId": "getProofStatus",
        "summary": "Read verification result",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProofResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          }
        },
        "parameters": []
      }
    },
    "/migrations/{migrationId}/claims": {
      "parameters": [
        {
          "$ref": "#/components/parameters/MigrationId"
        }
      ],
      "get": {
        "operationId": "listClaims",
        "summary": "List claims using cursor pagination",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "$ref": "#/components/parameters/PageLimit"
          }
        ]
      }
    },
    "/migrations/{migrationId}/claims/{claimId}/receipt": {
      "parameters": [
        {
          "$ref": "#/components/parameters/MigrationId"
        },
        {
          "$ref": "#/components/parameters/ClaimId"
        }
      ],
      "get": {
        "operationId": "getClaimReceipt",
        "summary": "Read destination claim receipt",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimReceipt"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          }
        },
        "parameters": []
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Validate signature, issuer, audience, expiry, subject, tenant_id and roles before authorization."
      }
    },
    "parameters": {
      "MigrationId": {
        "name": "migrationId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "ClaimId": {
        "name": "claimId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "ProofId": {
        "name": "proofId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 8,
          "maxLength": 200
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 2048
        }
      },
      "PageLimit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid authentication",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Tenant or role authorization denied",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found within tenant",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Conflict": {
        "description": "Lifecycle or idempotency conflict",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unprocessable": {
        "description": "Evidence, asset, proof, backing, or lifecycle precondition rejected",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "ServerError": {
        "description": "Service unavailable",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiError"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "invalid_request",
              "unauthorized",
              "forbidden",
              "not_found",
              "conflict",
              "idempotency_conflict",
              "invalid_transition",
              "unsupported_asset",
              "source_unverified",
              "migration_paused",
              "insufficient_backing",
              "invalid_proof",
              "approval_required",
              "evidence_expired",
              "rate_limited",
              "internal_error"
            ]
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "retryable": {
            "type": "boolean"
          }
        }
      },
      "Readiness": {
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready"
            ]
          },
          "version": {
            "type": "string"
          }
        }
      },
      "CreateMigrationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "migration_key",
          "source_chain",
          "destination_chain",
          "source_asset",
          "authorized_allocation"
        ],
        "properties": {
          "migration_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "source_chain": {
            "type": "object",
            "required": [
              "namespace",
              "reference"
            ]
          },
          "destination_chain": {
            "type": "object",
            "required": [
              "namespace",
              "reference"
            ]
          },
          "source_asset": {
            "type": "object",
            "required": [
              "namespace",
              "reference",
              "standard"
            ]
          },
          "authorized_allocation": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          }
        }
      },
      "Migration": {
        "type": "object",
        "required": [
          "id",
          "migration_key",
          "status",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "migration_key": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "enumerating",
              "frozen",
              "verifying",
              "review",
              "approved",
              "funding",
              "ready",
              "activated",
              "paused",
              "cancelled",
              "completed",
              "incident"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "MigrationStatus": {
        "type": "object",
        "required": [
          "migration_id",
          "status",
          "accounting"
        ],
        "properties": {
          "migration_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "accounting": {
            "type": "object",
            "required": [
              "authorized_allocation",
              "total_funded",
              "total_settled",
              "remaining_funded_liability",
              "available_backing"
            ],
            "properties": {
              "authorized_allocation": {
                "type": "string"
              },
              "total_funded": {
                "type": "string"
              },
              "total_settled": {
                "type": "string"
              },
              "remaining_funded_liability": {
                "type": "string"
              },
              "unfunded_authorized_allocation": {
                "type": "string"
              },
              "available_backing": {
                "type": "string"
              }
            }
          }
        }
      },
      "VerificationRequest": {
        "type": "object",
        "required": [
          "manifest_version",
          "verification_profile"
        ],
        "properties": {
          "manifest_version": {
            "type": "integer",
            "minimum": 1
          },
          "verification_profile": {
            "type": "string",
            "enum": [
              "standard",
              "strict"
            ]
          }
        }
      },
      "Job": {
        "type": "object",
        "required": [
          "id",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled",
              "retry_wait"
            ]
          }
        }
      },
      "ApprovalRequest": {
        "type": "object",
        "required": [
          "approval_kind",
          "subject_digest",
          "signer_identity",
          "signature"
        ],
        "properties": {
          "approval_kind": {
            "type": "string"
          },
          "subject_digest": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          },
          "signer_identity": {
            "type": "string"
          },
          "signature": {
            "type": "string",
            "description": "Base64 signature bytes, never a private key."
          },
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "reject"
            ]
          }
        }
      },
      "Approval": {
        "type": "object",
        "required": [
          "id",
          "approval_kind",
          "subject_digest"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "approval_kind": {
            "type": "string"
          },
          "subject_digest": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          }
        }
      },
      "ActivationRequest": {
        "type": "object",
        "required": [
          "manifest_version",
          "expected_root",
          "approval_ids"
        ],
        "properties": {
          "manifest_version": {
            "type": "integer"
          },
          "expected_root": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          },
          "approval_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "CancellationRequest": {
        "type": "object",
        "required": [
          "reason_code",
          "expected_version"
        ],
        "properties": {
          "reason_code": {
            "type": "string"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "DisputeRequest": {
        "type": "object",
        "required": [
          "claim_id",
          "category",
          "reason_code"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "format": "uuid"
          },
          "category": {
            "type": "string",
            "enum": [
              "ownership",
              "amount",
              "proof",
              "beneficiary",
              "settlement",
              "other"
            ]
          },
          "reason_code": {
            "type": "string"
          }
        }
      },
      "Dispute": {
        "type": "object",
        "required": [
          "id",
          "claim_id",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "claim_id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "open",
              "under_review",
              "resolved",
              "rejected"
            ]
          }
        }
      },
      "ProofResult": {
        "type": "object",
        "required": [
          "id",
          "outcome",
          "verifier_version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "verified",
              "rejected",
              "inconclusive"
            ]
          },
          "verifier_version": {
            "type": "string"
          }
        }
      },
      "Claim": {
        "type": "object",
        "required": [
          "id",
          "amount",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "state": {
            "type": "string",
            "enum": [
              "eligible",
              "submitted",
              "settled",
              "failed",
              "disputed"
            ]
          }
        }
      },
      "ClaimPage": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Claim"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ClaimReceipt": {
        "type": "object",
        "required": [
          "claim_id",
          "transaction_hash",
          "block_number",
          "block_hash",
          "amount"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "format": "uuid"
          },
          "transaction_hash": {
            "type": "string"
          },
          "block_number": {
            "type": "string"
          },
          "block_hash": {
            "type": "string"
          },
          "amount": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
